---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../config";

interface Props {
  title?: string;
  description?: string;
  contentClass?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description[0],
  contentClass = "",
} = Astro.props;

// Custom blur-fade animation configuration
const blurFadeAnimation = {
  old: {
    name: "blurFadeOut",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "forwards",
  },
  new: {
    name: "blurFadeIn",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "backwards",
  },
};

const pageTransition = {
  forwards: blurFadeAnimation,
  backwards: blurFadeAnimation,
};

const origin = Astro.url.origin;
const isHomePage = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en" class="bg-base-100" transition:animate={pageTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/kiwi.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={origin} />
    <meta property="og:image" content={`${origin}/images/flo_1_0.webp`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/images/flo_1_0.webp`} />
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <!-- Top Banner / Navbar -->
    <header class="safe-top-inset sticky top-0 z-50 w-full border-b border-base-content/10 bg-base-200/60 backdrop-blur">
      <div class="mx-auto flex min-h-12 max-w-6xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 py-1.5">
        <div class="flex shrink-0 items-center gap-2">
          <a
            href="/"
            class="inline-flex items-center text-base font-bold tracking-tight text-base-content transition-colors hover:text-primary"
          >
            {siteConfig.name}
          </a>
          <a
            href="/"
            aria-label="Back to Home"
            aria-hidden={isHomePage ? "true" : "false"}
            tabindex={isHomePage ? "-1" : undefined}
            class:list={[
              "ml-1 hidden size-7 items-center justify-center rounded-full bg-base-100 p-0 text-base-content/70 shadow-sm ring-1 ring-base-content/10 transition-colors hover:bg-base-100 hover:text-primary min-[500px]:inline-flex md:ml-6 lg:ml-8",
              isHomePage && "pointer-events-none invisible",
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4.5"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </a>
        </div>
        <nav class="ml-auto flex shrink-0 flex-nowrap items-center justify-end gap-2 whitespace-nowrap text-[13px] font-medium leading-none sm:gap-3 sm:text-sm">
          <span class="hidden min-[350px]:max-[499px]:block h-4 w-px bg-base-content/20" aria-hidden="true"></span>
          {siteConfig.socialLinks.github && (
            <a
              href={siteConfig.socialLinks.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="inline-flex items-center text-base-content/70 transition-colors hover:text-primary"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-[18px]" aria-hidden="true" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/></svg>
            </a>
          )}
          {siteConfig.socialLinks.linkedin && (
            <>
              <span class="h-4 w-px bg-base-content/20" aria-hidden="true"></span>
              <a
                href={siteConfig.socialLinks.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="inline-flex items-center text-base-content/70 transition-colors hover:text-primary"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-[18px]" aria-hidden="true" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>
              </a>
            </>
          )}
          {siteConfig.socialLinks.resume && (
            <>
              <span class="h-4 w-px bg-base-content/20" aria-hidden="true"></span>
              <button
                type="button"
                data-pdf-overlay-open
                data-pdf-src={siteConfig.socialLinks.resume}
                data-pdf-label="resume"
                aria-haspopup="dialog"
                class="inline-flex cursor-pointer items-center text-base-content/70 transition-colors hover:text-primary"
              >
                Resume
              </button>
            </>
          )}
          <span class="h-4 w-px bg-base-content/20" aria-hidden="true"></span>
          <a href="/about" class="inline-flex items-center text-base-content/70 transition-colors hover:text-primary">About me</a>
        </nav>
      </div>
    </header>

    <div class:list={["flex-1", contentClass]}>
      <slot />
    </div>

    <footer aria-hidden="true" class="safe-bottom-inset footer-safe-height relative mt-auto -mt-2 overflow-hidden bg-base-200">
      <img
        src="/telluride_no_bg.webp"
        alt=""
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-top opacity-80"
      />
    </footer>

    <div
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
      data-pdf-overlay
      role="dialog"
      aria-modal="true"
      aria-label="PDF viewer"
    >
      <button
        type="button"
        class="absolute inset-0 h-full w-full cursor-default"
        aria-label="Close PDF viewer"
        data-pdf-overlay-close
      ></button>
      <div class="pdf-overlay-frame relative z-10">
        <div class="surface-card relative h-full w-full border border-base-300 bg-base-100 shadow-2xl">
          <object
            type="application/pdf"
            class="h-full w-full"
            data-pdf-overlay-object
          >
            <div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center text-sm text-base-content/70">
              <p>Inline preview is not available in this browser.</p>
              <a
                href={siteConfig.socialLinks.resume}
                target="_blank"
                rel="noopener noreferrer"
                class="link link-primary"
                data-pdf-overlay-fallback-link
              >
                Open PDF in a new tab
              </a>
            </div>
          </object>
        </div>
      </div>
    </div>

    <!-- Smooth Scroll -->
    <script>
      const baseUrl = import.meta.env.BASE_URL ?? "/";

      const normalizePdfSrc = (src) => {
        if (!src) return null;

        // Absolute URLs (http:, https:, etc.) should be used as-is.
        if (/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(src)) return src;

        // Root-relative URLs already include any deployment prefix if present.
        if (src.startsWith("/")) return src;

        const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
        return `${base}${src}`;
      };

      const initPdfOverlay = () => {
        const overlay = document.querySelector("[data-pdf-overlay]");
        const objectEl = document.querySelector("[data-pdf-overlay-object]");
        const fallbackLink = document.querySelector("[data-pdf-overlay-fallback-link]");
        const closeButtons = document.querySelectorAll("[data-pdf-overlay-close]");
        const triggers = document.querySelectorAll("[data-pdf-overlay-open]");

        if (
          !(overlay instanceof HTMLElement) ||
          !(objectEl instanceof HTMLObjectElement) ||
          !(fallbackLink instanceof HTMLAnchorElement)
        ) {
          return;
        }

        let lastTrigger = null;

        const closeOverlay = () => {
          overlay.classList.add("hidden");
          overlay.classList.remove("flex");
          document.body.classList.remove("overflow-hidden");

          if (lastTrigger instanceof HTMLElement) {
            lastTrigger.focus();
          }
        };

        const openOverlay = (trigger, event) => {
          // Let users open in a new tab/window using modifiers.
          if (event instanceof MouseEvent) {
            if (event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          }

          const rawSrc =
            trigger.getAttribute("data-pdf-src") ||
            (trigger instanceof HTMLAnchorElement ? trigger.getAttribute("href") : null) ||
            "";
          const label = trigger.getAttribute("data-pdf-label") || "PDF";
          const href = normalizePdfSrc(rawSrc);

          if (!href) return;

          event?.preventDefault?.();
          lastTrigger = trigger;

          objectEl.setAttribute("data", `${href}#view=FitH`);
          fallbackLink.href = href;
          fallbackLink.textContent = `Open ${label} in a new tab`;

          overlay.classList.remove("hidden");
          overlay.classList.add("flex");
          document.body.classList.add("overflow-hidden");
        };

        triggers.forEach((trigger) => {
          if (!(trigger instanceof HTMLElement)) return;
          if (trigger.dataset.pdfOverlayReady === "true") return;
          trigger.dataset.pdfOverlayReady = "true";

          trigger.addEventListener("click", (event) => openOverlay(trigger, event));
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeOverlay);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !overlay.classList.contains("hidden")) {
            closeOverlay();
          }
        });
      };

      const initVideos = () => {
        document.querySelectorAll("video[autoplay]").forEach((video) => {
          if (video instanceof HTMLVideoElement) {
            video.play().catch(() => {});
          }
        });
      };

      const initExternalLinks = () => {
        document.querySelectorAll("a[href]").forEach((a) => {
          if (!(a instanceof HTMLAnchorElement)) return;
          const href = a.getAttribute("href") ?? "";
          const isExternal =
            href.startsWith("http://") ||
            href.startsWith("https://") ||
            href.startsWith("//");
          if (isExternal && a.target !== "_blank") {
            a.target = "_blank";
            a.rel = "noopener noreferrer";
          }
        });
      };

      initPdfOverlay();
      initExternalLinks();
      document.addEventListener("astro:page-load", initPdfOverlay);
      document.addEventListener("astro:page-load", initVideos);
      document.addEventListener("astro:page-load", initExternalLinks);
    </script>
    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      /* Initial Page Load Blur-Fade Animation */
      @keyframes pageLoadBlurFade {
        0% {
          opacity: 0;
          filter: blur(8px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      html {
        animation: pageLoadBlurFade 0.3s ease-in-out;
        animation-fill-mode: both;
      }

      /* Blur Fade View Transitions (for page-to-page navigation) */
      @keyframes blurFadeIn {
        0% {
          opacity: 0;
          filter: blur(10px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      @keyframes blurFadeOut {
        0% {
          opacity: 1;
          filter: blur(0px);
        }
        100% {
          opacity: 0;
          filter: blur(10px);
        }
      }

      .pdf-overlay-frame {
        /* Keep the viewer between letter (8.5:11) and square (1:1).
           This prevents a too-tall frame on narrow screens (hard to close). */
        --pdf-overlay-max-h: min(92vh, calc(100vh - 3rem));
        --pdf-overlay-max-w: min(calc(100vw - 2rem), var(--pdf-overlay-max-h));

        width: min(100%, var(--pdf-overlay-max-w));
        height: min(var(--pdf-overlay-max-h), calc(var(--pdf-overlay-max-w) * 1.2941176));
      }
    </style>
  </body>
</html>
