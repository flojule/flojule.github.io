---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description[0],
} = Astro.props;

// Custom blur-fade animation configuration
const blurFadeAnimation = {
  old: {
    name: "blurFadeOut",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "forwards",
  },
  new: {
    name: "blurFadeIn",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "backwards",
  },
};

const pageTransition = {
  forwards: blurFadeAnimation,
  backwards: blurFadeAnimation,
};

const origin = Astro.url.origin;
const isHomePage = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en" class="bg-base-100" transition:animate={pageTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/kiwi.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={origin} />
    <meta property="og:image" content={`${origin}/images/og_home.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/images/og_home.png`} />
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <!-- Top Banner / Navbar -->
    <header class="safe-top-inset sticky top-0 z-50 w-full border-b border-base-content/10 bg-base-200/60 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-col gap-1.5 px-4 py-2 md:h-12 md:flex-row md:items-center md:justify-between md:py-0">
        <div class="flex items-center gap-3">
          <a
            href="/"
            class="inline-flex min-h-9 items-center text-sm font-bold tracking-tight text-base-content transition-colors hover:text-primary md:min-h-0 md:text-base"
          >
            {siteConfig.name}
          </a>
          {
            !isHomePage && (
              <a
                href="/"
                aria-label="Back to Home"
                class="ml-2 inline-flex size-8 items-center justify-center rounded-full bg-base-100/55 text-base-content/70 shadow-sm ring-1 ring-base-content/10 transition-colors hover:bg-base-100/80 hover:text-primary md:ml-6 md:size-7 lg:ml-8"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m15 18-6-6 6-6"></path>
                </svg>
              </a>
            )
          }
        </div>
        <nav class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[13px] font-medium sm:gap-x-3 sm:text-sm md:gap-x-4">
          <a href="/about" class="inline-flex min-h-9 items-center rounded-full px-1.5 text-base-content/70 transition-colors hover:text-primary md:min-h-0 md:px-0">About me</a>
          {siteConfig.socialLinks.github && (
            <a
              href={siteConfig.socialLinks.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-9 items-center rounded-full px-1.5 text-base-content/70 transition-colors hover:text-primary md:min-h-0 md:px-0"
            >
              GitHub
            </a>
          )}
          {siteConfig.socialLinks.linkedin && (
            <a
              href={siteConfig.socialLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-9 items-center rounded-full px-1.5 text-base-content/70 transition-colors hover:text-primary md:min-h-0 md:px-0"
            >
              LinkedIn
            </a>
          )}
          {siteConfig.socialLinks.resume && (
            <button
              type="button"
              data-resume-overlay-open
              data-resume-src={siteConfig.socialLinks.resume}
              aria-haspopup="dialog"
              class="inline-flex min-h-9 items-center rounded-full px-1.5 text-base-content/70 transition-colors hover:text-primary md:min-h-0 md:px-0"
            >
              Resume
            </button>
          )}
        </nav>
      </div>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <footer aria-hidden="true" class="safe-bottom-inset footer-safe-height relative mt-auto -mt-2 overflow-hidden bg-base-200">
      <img
        src="/telluride_no_bg.webp"
        alt=""
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-top opacity-80"
      />
    </footer>

    <div
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
      data-resume-overlay
      role="dialog"
      aria-modal="true"
      aria-label="Resume viewer"
    >
      <button
        type="button"
        class="absolute inset-0 h-full w-full cursor-default"
        aria-label="Close resume viewer"
        data-resume-overlay-close
      ></button>
      <div class="relative z-10 flex h-[85vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-2xl">
        <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
          <p class="text-sm font-semibold tracking-wide text-base-content/70">Resume</p>
          <div class="flex items-center gap-2">
            <a
              href={siteConfig.socialLinks.resume}
              download
              class="btn btn-sm btn-ghost"
              data-resume-download
            >
              Download
            </a>
            <button
              type="button"
              class="btn btn-circle btn-sm btn-ghost"
              aria-label="Close resume viewer"
              data-resume-overlay-close
            >
              ×
            </button>
          </div>
        </div>
        <div class="h-full w-full bg-base-100">
          <object
            data={`${siteConfig.socialLinks.resume}#view=FitH`}
            type="application/pdf"
            class="h-full w-full"
            data-resume-object
          >
            <div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center text-sm text-base-content/70">
              <p>Inline preview is not available in this browser.</p>
              <a
                href={siteConfig.socialLinks.resume}
                target="_blank"
                rel="noopener noreferrer"
                class="link link-primary"
              >
                Open resume in a new tab
              </a>
            </div>
          </object>
        </div>
      </div>
    </div>

    <!-- Smooth Scroll -->
    <script>
      const initResumeOverlay = () => {
        const resumeOpenButton = document.querySelector("[data-resume-overlay-open]");
        const resumeOverlay = document.querySelector("[data-resume-overlay]");
        const resumeCloseButtons = document.querySelectorAll("[data-resume-overlay-close]");

        if (
          !(resumeOpenButton instanceof HTMLButtonElement) ||
          !(resumeOverlay instanceof HTMLElement) ||
          resumeOpenButton.dataset.resumeOverlayReady === "true"
        ) {
          return;
        }

        resumeOpenButton.dataset.resumeOverlayReady = "true";

        let lastResumeTrigger = null;

        const closeResumeOverlay = () => {
          resumeOverlay.classList.add("hidden");
          resumeOverlay.classList.remove("flex");

          if (lastResumeTrigger instanceof HTMLElement) {
            lastResumeTrigger.focus();
          }
        };

        resumeOpenButton.addEventListener("click", () => {
          lastResumeTrigger = resumeOpenButton;
          resumeOverlay.classList.remove("hidden");
          resumeOverlay.classList.add("flex");
        });

        resumeCloseButtons.forEach((button) => {
          button.addEventListener("click", closeResumeOverlay);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !resumeOverlay.classList.contains("hidden")) {
            closeResumeOverlay();
          }
        });
      };

      initResumeOverlay();
      document.addEventListener("astro:page-load", initResumeOverlay);
    </script>
    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      /* Initial Page Load Blur-Fade Animation */
      @keyframes pageLoadBlurFade {
        0% {
          opacity: 0;
          filter: blur(8px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      html {
        animation: pageLoadBlurFade 0.3s ease-in-out;
        animation-fill-mode: both;
      }

      /* Blur Fade View Transitions (for page-to-page navigation) */
      @keyframes blurFadeIn {
        0% {
          opacity: 0;
          filter: blur(10px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      @keyframes blurFadeOut {
        0% {
          opacity: 1;
          filter: blur(0px);
        }
        100% {
          opacity: 0;
          filter: blur(10px);
        }
      }
    </style>
  </body>
</html>
