---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Image } from "astro:assets";
// Aliased: `Image` is already the astro:assets component in this file.
import { FileText, Image as GalleryIcon, Moon, Sun, User } from "@lucide/astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import { siteConfig } from "../config";
import footerRidge from "../assets/telluride_no_bg.webp";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  contentClass?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description[0],
  image = siteConfig.ogImage,
  contentClass = "",
} = Astro.props;

// Custom blur-fade animation configuration
const blurFadeAnimation = {
  old: {
    name: "blurFadeOut",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "forwards",
  },
  new: {
    name: "blurFadeIn",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "backwards",
  },
};

const pageTransition = {
  forwards: blurFadeAnimation,
  backwards: blurFadeAnimation,
};

const pageUrl = Astro.url.href;
// Resolves both site-relative paths and absolute remote image URLs.
const imageUrl = new URL(image, Astro.url).href;
---

<!doctype html>
<html lang="en" class="bg-base-100" transition:animate={pageTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/kiwi.svg" />
    <link rel="canonical" href={pageUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Applies the stored theme before first paint so there is no flash of the
         wrong scheme. No stored choice means no data-theme, which leaves the
         daisyUI `--prefersdark` default following the OS. Re-applied after each
         view transition, which restores <html> attributes from the new page. -->
    <script is:inline>
      (() => {
        const applyTheme = () => {
          // Blocked storage (private browsing, cookies disabled) throws on
          // access; falling through to the OS preference is the right default.
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch {}
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          } else {
            delete document.documentElement.dataset.theme;
          }
        };
        applyTheme();
        if (!window.__themeSwapBound) {
          window.__themeSwapBound = true;
          document.addEventListener("astro:after-swap", applyTheme);
        }
      })();
    </script>

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Privacy-friendly, cookieless visit analytics (GoatCounter). -->
    <script is:inline data-goatcounter="https://flojule.goatcounter.com/count" async src="//gc.zgo.at/count.js"
    ></script>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <!-- Top Banner / Navbar -->
    <header class="safe-top-inset sticky top-0 z-50 w-full border-b border-base-content/10 bg-base-200/60 backdrop-blur">
      <!-- Padding sits outside the max-width, matching the page sections below
           (`px-4` on the section, `max-w-6xl` on its inner div). Putting it
           inside instead lines up until both containers hit 6xl, then insets
           the bar 16px from the content grid. -->
      <div class="px-3 min-[360px]:px-4">
        <div class="mx-auto flex min-h-12 max-w-6xl flex-wrap items-center justify-between gap-x-1 gap-y-1 py-1.5">
          <div class="flex shrink-0 items-center gap-2">
            <a
              href="/"
              class="inline-flex items-center text-sm font-bold tracking-tight text-base-content transition-colors hover:text-primary min-[375px]:text-base"
            >
              {siteConfig.name}
            </a>
          </div>
          <!-- Every control is an icon of the same size carrying the same brief
               label, evenly spaced, no dividers. Only the gap changes across
               breakpoints — the icons are one size everywhere — so nothing is
               ever added, removed or resized as the viewport changes. -->
          <nav class="ml-auto -mr-1 flex shrink-0 flex-nowrap items-center justify-end gap-0 min-[360px]:gap-1 sm:gap-2">
            <button
              type="button"
              data-photo-gallery-open
              aria-label="Photos"
              title="Photos"
              aria-haspopup="dialog"
              class="icon-btn"
            >
              <GalleryIcon class="nav-icon" aria-hidden="true" />
            </button>
            {siteConfig.socialLinks.github && (
              <a
                href={siteConfig.socialLinks.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                title="GitHub"
                class="icon-btn"
              >
                <GithubIcon class="nav-icon" />
              </a>
            )}
            {siteConfig.socialLinks.linkedin && (
              <a
                href={siteConfig.socialLinks.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                title="LinkedIn"
                class="icon-btn"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="nav-icon" aria-hidden="true" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>
              </a>
            )}
            {siteConfig.socialLinks.resume && (
              <button
                type="button"
                data-pdf-overlay-open
                data-pdf-src={siteConfig.socialLinks.resume}
                data-pdf-label="resume"
                aria-label="Resume"
                title="Resume"
                aria-haspopup="dialog"
                class="icon-btn"
              >
                <FileText class="nav-icon" aria-hidden="true" />
              </button>
            )}
            <a href="/about" aria-label="About" title="About" class="icon-btn">
              <User class="nav-icon" aria-hidden="true" />
            </a>
            <button
              type="button"
              data-theme-toggle
              aria-label="Theme"
              title="Theme"
              class="icon-btn"
            >
              <Moon class="nav-icon" data-theme-icon="moon" aria-hidden="true" />
              <Sun class="nav-icon" data-theme-icon="sun" aria-hidden="true" />
            </button>
          </nav>
        </div>
      </div>
    </header>

    <div class:list={["flex-1", contentClass]}>
      <slot />
    </div>

    <footer class="safe-bottom-inset footer-safe-height relative mt-auto -mt-2 overflow-hidden bg-base-200">
      <Image
        src={footerRidge}
        alt=""
        aria-hidden="true"
        width={1280}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-top opacity-80"
      />
      <p class="absolute bottom-2 right-3 z-10 text-[11px] text-base-content/50">
        © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </p>
    </footer>

    <PhotoLightbox />

    <div
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
      data-pdf-overlay
      role="dialog"
      aria-modal="true"
      aria-label="PDF viewer"
    >
      <button
        type="button"
        class="absolute inset-0 h-full w-full cursor-default"
        aria-label="Close PDF viewer"
        data-pdf-overlay-close
      ></button>
      <div class="pdf-overlay-frame relative z-10">
        <div class="surface-card relative h-full w-full border border-base-300 bg-base-100 shadow-2xl">
          <object
            type="application/pdf"
            class="h-full w-full"
            data-pdf-overlay-object
          >
            <div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center text-sm text-base-content/70">
              <p>Inline preview is not available in this browser.</p>
              <a
                href={siteConfig.socialLinks.resume}
                target="_blank"
                rel="noopener noreferrer"
                class="link link-primary"
                data-pdf-overlay-fallback-link
              >
                Open PDF in a new tab
              </a>
            </div>
          </object>
        </div>
      </div>
    </div>

    <!-- Smooth Scroll -->
    <script>
      import { closeOverlay, isOverlayOpen, openOverlay } from "../lib/overlay";

      const baseUrl = import.meta.env.BASE_URL ?? "/";

      const normalizePdfSrc = (src: string) => {
        if (!src) return null;

        // Absolute URLs (http:, https:, etc.) should be used as-is.
        if (/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(src)) return src;

        // Root-relative URLs already include any deployment prefix if present.
        if (src.startsWith("/")) return src;

        const base = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
        return `${base}${src}`;
      };

      // Applied to every PDF the overlay opens, so a new link cannot forget
      // them. Chromium's viewer honours these; Firefox (pdf.js) and Safari
      // ignore them and always draw their own chrome.
      // `scrollbar` is deliberately left alone — these PDFs are multi-page.
      // `pagemode=none` is the pdf.js spelling of `navpanes=0`: the patent PDF
      // sets /PageMode /UseOutlines internally, so Firefox opens its sidebar
      // unless the URL overrides it.
      const VIEWER_PARAMS = "toolbar=0&navpanes=0&pagemode=none&view=FitH";

      // Viewer params must join the fragment the href may already carry;
      // a second "#" makes the whole thing a literal fragment and silently
      // disables both sets of options.
      const withViewerParams = (href: string) => {
        const [path, fragment = ""] = href.split("#");
        return `${path}#${fragment ? `${fragment}&` : ""}${VIEWER_PARAMS}`;
      };

      const initPdfOverlay = () => {
        const overlay = document.querySelector("[data-pdf-overlay]");
        const objectEl = document.querySelector("[data-pdf-overlay-object]");
        const fallbackLink = document.querySelector("[data-pdf-overlay-fallback-link]");
        const closeButtons = document.querySelectorAll("[data-pdf-overlay-close]");
        const triggers = document.querySelectorAll("[data-pdf-overlay-open]");

        if (
          !(overlay instanceof HTMLElement) ||
          !(objectEl instanceof HTMLObjectElement) ||
          !(fallbackLink instanceof HTMLAnchorElement)
        ) {
          return;
        }

        let lastTrigger: HTMLElement | null = null;

        const close = () => {
          closeOverlay(overlay);

          if (lastTrigger instanceof HTMLElement) {
            lastTrigger.focus();
          }
        };

        const openPdf = (trigger: HTMLElement, event: Event) => {
          // Let users open in a new tab/window using modifiers.
          if (event instanceof MouseEvent) {
            if (event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          }

          const rawSrc =
            trigger.getAttribute("data-pdf-src") ||
            (trigger instanceof HTMLAnchorElement ? trigger.getAttribute("href") : null) ||
            "";
          const label = trigger.getAttribute("data-pdf-label") || "PDF";
          const href = normalizePdfSrc(rawSrc);

          if (!href) return;

          event?.preventDefault?.();
          lastTrigger = trigger;

          objectEl.setAttribute("data", withViewerParams(href));
          fallbackLink.href = href;
          fallbackLink.textContent = `Open ${label} in a new tab`;

          openOverlay(overlay);
        };

        triggers.forEach((trigger) => {
          if (!(trigger instanceof HTMLElement)) return;
          if (trigger.dataset.pdfOverlayReady === "true") return;
          trigger.dataset.pdfOverlayReady = "true";

          trigger.addEventListener("click", (event) => openPdf(trigger, event));
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", close);
        });
      };

      // Bound once at module scope. Registering it inside init() would stack a
      // new listener — closed over a detached overlay — on every navigation.
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const overlay = document.querySelector("[data-pdf-overlay]");
        if (isOverlayOpen(overlay)) closeOverlay(overlay);
      });

      // Autoplay videos carry a `data-autoplay` marker + preload="none" so the
      // static HTML never starts downloads. JS then autoplays whatever is in
      // view and prefetches the rest one at a time, so upcoming videos are
      // buffered before you reach them without flooding Firefox's per-host
      // connection limit (the original all-at-once failure).
      const figureVideos = () =>
        Array.from(document.querySelectorAll("video[data-autoplay]")).filter(
          (v): v is HTMLVideoElement => v instanceof HTMLVideoElement,
        );

      // Card thumbnails opt out of eager buffering entirely. Forcing
      // preload="auto" pulls each clip in full the moment it nears the
      // viewport, which on a grid of them is tens of MB before you have
      // scrolled anywhere. They stream progressively while playing instead,
      // and stop fetching when they scroll out and pause.
      const prefetchableVideos = () =>
        figureVideos().filter((v) => !v.hasAttribute("data-no-prefetch"));

      // Autoplaying loops have no pause affordance on cards, and they are the
      // bulk of the page weight. Reduced-motion visitors keep the poster and
      // download nothing until they ask for playback via the controls.
      const prefersReducedMotion = () =>
        window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;

      const tryPlay = (video: HTMLVideoElement) => {
        if (prefersReducedMotion()) return;
        const p = video.play();
        if (p && typeof p.catch === "function") p.catch(() => {});
      };

      // Force a download even though the attribute hint is preload="none".
      const startBuffering = (video: HTMLVideoElement) => {
        if (prefersReducedMotion()) return;
        if (video.dataset.buffering === "1") return;
        video.dataset.buffering = "1";
        video.preload = "auto";
        video.load();
      };

      // Keep up to MAX_PARALLEL videos buffering at once (document order), so a
      // couple are ready ahead of you without flooding the per-host connection
      // limit. An in-view video jumps ahead via the observer below.
      const MAX_PARALLEL = 2;
      // ...but only read ahead this far. Chaining through every video on the
      // page pulls the whole article's media on a bounce; a media-heavy page
      // is >100MB of clips the visitor never scrolls to.
      const PREFETCH_AHEAD_SCREENS = 2;
      const isApproaching = (video: HTMLVideoElement) =>
        video.getBoundingClientRect().top <
        window.innerHeight * (1 + PREFETCH_AHEAD_SCREENS);
      const activeLoads = () =>
        prefetchableVideos().filter(
          (v) => v.dataset.buffering === "1" && v.dataset.buffered !== "1",
        ).length;
      const pumpPrefetch = () => {
        while (activeLoads() < MAX_PARALLEL) {
          const next = prefetchableVideos().find(
            (v) => v.dataset.buffering !== "1" && isApproaching(v),
          );
          if (!next) break;
          startBuffering(next);
        }
      };

      // Scrolling brings more videos into read-ahead range. Bound once at
      // module scope; rAF-coalesced so a scroll burst pumps at most per frame.
      let pumpQueued = false;
      const queuePump = () => {
        if (pumpQueued) return;
        pumpQueued = true;
        requestAnimationFrame(() => {
          pumpQueued = false;
          pumpPrefetch();
        });
      };
      window.addEventListener("scroll", queuePump, { passive: true });
      window.addEventListener("resize", queuePump, { passive: true });

      const onIntersect = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (!(video instanceof HTMLVideoElement)) return;
          if (entry.isIntersecting) {
            // Only read-ahead videos get the forced full download; cards just play.
            if (!video.hasAttribute("data-no-prefetch")) startBuffering(video);
            tryPlay(video);
          } else {
            video.pause();
          }
        });
      };

      const makeObserver = (rootMargin: string) =>
        "IntersectionObserver" in window
          ? new IntersectionObserver(onIntersect, { rootMargin })
          : null;

      // Project-page figures start just before they scroll in. Card thumbnails
      // wait until they are actually on screen, so an unseen row costs nothing.
      const figureObserver = makeObserver("300px 0px");
      const cardObserver = makeObserver("0px");
      const observerFor = (video: HTMLVideoElement) =>
        video.hasAttribute("data-no-prefetch") ? cardObserver : figureObserver;

      const initVideos = () => {
        // Drop observations of the previous page's (now detached) videos.
        figureObserver?.disconnect();
        cardObserver?.disconnect();
        const reducedMotion = prefersReducedMotion();
        figureVideos().forEach((video) => {
          video.muted = true; // Safari only honors muted autoplay via the property
          video.playsInline = true;
          if (reducedMotion) {
            // Poster only, plus a way to start it deliberately.
            video.controls = true;
            return;
          }
          // Bind handlers once even though init runs on both swap and page-load.
          if (!video.dataset.videoBound) {
            video.dataset.videoBound = "1";
            // Native controls stay hidden by default; reveal the control bar on
            // mouse hover (pointer devices) and toggle on tap (touch devices),
            // except on opted-out previews (e.g. project-card thumbnails).
            if (!video.hasAttribute("data-no-controls")) {
              video.addEventListener("pointerenter", (e) => {
                if (e.pointerType === "mouse") video.controls = true;
              });
              video.addEventListener("pointerleave", (e) => {
                if (e.pointerType === "mouse") video.controls = false;
              });
              video.addEventListener("pointerdown", (e) => {
                if (e.pointerType !== "mouse") video.controls = !video.controls;
              });
            }
            // Firefox can fail <source> selection during a view-transition swap
            // and report MEDIA_ERR_SRC_NOT_SUPPORTED though the files are fine;
            // re-running load() re-selects the source and self-heals.
            video.addEventListener("error", () => {
              const tries = Number(video.dataset.reselectTries || "0");
              if (tries < 3) {
                video.dataset.reselectTries = String(tries + 1);
                video.load();
                tryPlay(video);
                return; // retrying: keep its slot; canplaythrough will pump next
              }
              video.dataset.buffered = "1"; // gave up: free its slot, keep going
              pumpPrefetch();
            });
            video.addEventListener(
              "canplaythrough",
              () => {
                video.dataset.buffered = "1";
                pumpPrefetch();
              },
              { once: true },
            );
            video.addEventListener("loadeddata", () => tryPlay(video));
            video.addEventListener("canplay", () => tryPlay(video));
          }
          const observer = observerFor(video);
          if (observer) observer.observe(video);
          else tryPlay(video); // no IntersectionObserver: play, but never force-load
        });
        pumpPrefetch(); // kick off the background prefetch chain
      };

      const initExternalLinks = () => {
        document.querySelectorAll("a[href]").forEach((a) => {
          if (!(a instanceof HTMLAnchorElement)) return;
          const href = a.getAttribute("href") ?? "";
          const isExternal =
            href.startsWith("http://") ||
            href.startsWith("https://") ||
            href.startsWith("//");
          if (isExternal && a.target !== "_blank") {
            a.target = "_blank";
            a.rel = "noopener noreferrer";
          }
        });
      };

      // Toggles against the *effective* scheme, so the first click from the
      // OS-follows default always lands on the opposite of what is on screen.
      const initThemeToggle = () => {
        const button = document.querySelector("[data-theme-toggle]");
        if (!(button instanceof HTMLElement)) return;
        if (button.dataset.themeToggleReady === "true") return;
        button.dataset.themeToggleReady = "true";

        button.addEventListener("click", () => {
          const root = document.documentElement;
          const isDark = root.dataset.theme
            ? root.dataset.theme === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          const next = isDark ? "light" : "dark";
          root.dataset.theme = next;
          // The toggle still works for this session if the write is refused.
          try {
            localStorage.setItem("theme", next);
          } catch {}
        });
      };

      // Shared by the 404 and 500 pages. A visitor who landed directly on an
      // error URL has no history entry to return to, so fall back to home
      // rather than leaving the button inert.
      const initGoBack = () => {
        const button = document.querySelector("[data-go-back]");
        if (!(button instanceof HTMLElement)) return;
        if (button.dataset.goBackReady === "true") return;
        button.dataset.goBackReady = "true";

        button.addEventListener("click", () => {
          if (window.history.length > 1) history.back();
          else window.location.href = "/";
        });
      };

      initPdfOverlay();
      initExternalLinks();
      initThemeToggle();
      initGoBack();
      document.addEventListener("astro:page-load", initGoBack);
      document.addEventListener("astro:page-load", initThemeToggle);
      document.addEventListener("astro:page-load", initPdfOverlay);
      document.addEventListener("astro:after-swap", initVideos);
      document.addEventListener("astro:page-load", initVideos);
      document.addEventListener("astro:page-load", initExternalLinks);
    </script>
    <style is:global>
      /* Initial Page Load Blur-Fade Animation */
      @keyframes pageLoadBlurFade {
        0% {
          opacity: 0;
          filter: blur(8px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      html {
        scroll-behavior: smooth;
        scrollbar-gutter: stable;
        animation: pageLoadBlurFade 0.3s ease-in-out both;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
          animation: none;
        }
      }

      /* Blur Fade View Transitions (for page-to-page navigation) */
      @keyframes blurFadeIn {
        0% {
          opacity: 0;
          filter: blur(10px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      @keyframes blurFadeOut {
        0% {
          opacity: 1;
          filter: blur(0px);
        }
        100% {
          opacity: 0;
          filter: blur(10px);
        }
      }

      .pdf-overlay-frame {
        /* Keep the viewer between letter (8.5:11) and square (1:1).
           This prevents a too-tall frame on narrow screens (hard to close). */
        --pdf-overlay-max-h: min(92vh, calc(100vh - 3rem));
        --pdf-overlay-max-w: min(calc(100vw - 2rem), var(--pdf-overlay-max-h));

        width: min(100%, var(--pdf-overlay-max-w));
        height: min(var(--pdf-overlay-max-h), calc(var(--pdf-overlay-max-w) * 1.2941176));
      }
    </style>
  </body>
</html>
