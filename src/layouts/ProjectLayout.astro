---
import Layout from "./Layout.astro";
import "katex/dist/katex.min.css";
import { Image } from "astro:assets";
import SkillBadge from "../components/SkillBadge.astro";
import { ExternalLink } from "@lucide/astro";
import { siteConfig } from "../config";

interface Props {
  title: string;
  description: string;
  startDate: Date;
  endDate?: Date;
  image: any;
  video?: string;
  skills: string[];
  demoLink?: string;
  demoLabel?: string;
  sourceLink?: string;
}

const {
  title,
  description,
  startDate,
  endDate,
  image,
  video,
  skills,
  demoLink,
  demoLabel = "Live Demo",
  sourceLink,
} = Astro.props;

const hasSkills = skills && skills.length > 0;

function getVideoMimeType(videoPath: string) {
  const extension = videoPath.split(".").pop()?.toLowerCase();
  if (extension === "webm") return "video/webm";
  if (extension === "ogg" || extension === "ogv") return "video/ogg";
  return "video/mp4";
}

function getVideoSources(videoPath: string) {
  const extension = videoPath.split(".").pop()?.toLowerCase();

  if (extension === "mp4") {
    const webmPath = videoPath.replace(/\.mp4$/i, ".webm");
    return [webmPath, videoPath];
  }

  return [videoPath];
}

function formatPeriod(startDate: Date, endDate?: Date) {
  const options: Intl.DateTimeFormatOptions = {
    month: "short",
    year: "numeric",
  };
  const start = startDate.toLocaleDateString("en-US", options);
  const end = endDate
    ? endDate.toLocaleDateString("en-US", options)
    : "Present";
  return `${start} - ${end}`;
}

---

<Layout title={`${siteConfig.name} - ${title}`} description={description}>
  <section class="bg-base-200">
    <article class="max-w-4xl mx-auto px-4 pt-3 pb-16">
    <!-- Featured Media -->
    {
      video ? (
        <figure class="mb-6 rounded-2xl overflow-hidden">
          <video
            autoplay
            controls
            muted
            playsinline
            preload="metadata"
            poster={image?.src}
            class="w-full aspect-video object-cover"
          >
            {getVideoSources(video).map((source) => (
              <source src={source} type={getVideoMimeType(source)} />
            ))}
            Your browser does not support this video format.
          </video>
        </figure>
      ) : image && (
        <figure class="mb-6 rounded-2xl overflow-hidden">
          <Image
            src={image}
            alt={title}
            class="w-full aspect-video object-cover"
            width={1200}
            height={630}
            sizes="(min-width: 1024px) 56rem, 100vw"
          />
        </figure>
      )
    }

    <!-- Project Header -->
    <header class="mb-2">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-3">{title}</h1>
      <p class="text-base sm:text-lg text-base-content/70 mb-3">{description}</p>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-base-content/60 mb-2">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="font-semibold">{formatPeriod(startDate, endDate)}</span>
          {
            !endDate && (
              <>
                <span class="text-base-content/30">|</span>
                <span class="badge badge-success badge-sm">Ongoing</span>
              </>
            )
          }
          {
            sourceLink && (
              <>
                <span class="text-base-content/30">|</span>
                <a
                  href={sourceLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 font-medium text-base-content/70 hover:text-primary transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 32 32"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M16,2.345c7.735,0,14,6.265,14,14-.002,6.015-3.839,11.359-9.537,13.282-.7,.14-.963-.298-.963-.665,0-.473,.018-1.978,.018-3.85,0-1.312-.437-2.152-.945-2.59,3.115-.35,6.388-1.54,6.388-6.912,0-1.54-.543-2.783-1.435-3.762,.14-.35,.63-1.785-.14-3.71,0,0-1.173-.385-3.85,1.435-1.12-.315-2.31-.472-3.5-.472s-2.38,.157-3.5,.472c-2.677-1.802-3.85-1.435-3.85-1.435-.77,1.925-.28,3.36-.14,3.71-.892,.98-1.435,2.24-1.435,3.762,0,5.355,3.255,6.563,6.37,6.913-.403,.35-.77,.963-.893,1.872-.805,.368-2.818,.963-4.077-1.155-.263-.42-1.05-1.452-2.152-1.435-1.173,.018-.472,.665,.017,.927,.595,.332,1.277,1.575,1.435,1.978,.28,.787,1.19,2.293,4.707,1.645,0,1.173,.018,2.275,.018,2.607,0,.368-.263,.787-.963,.665-5.719-1.904-9.576-7.255-9.573-13.283,0-7.735,6.265-14,14-14Z" />
                  </svg>
                  View Source
                </a>
              </>
            )
          }

          {
            demoLink && (
              <>
                <span class="text-base-content/30">|</span>
                <a
                  href={demoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 font-medium text-base-content/70 hover:text-primary transition-colors"
                >
                  <ExternalLink class="size-4" />
                  {demoLabel}
                </a>
              </>
            )
          }
        </div>

        {
          hasSkills && (
            <>
              <span class="text-base-content/30">|</span>
              {skills.map((skill) => (
                <SkillBadge skill={skill} />
              ))}
            </>
          )
        }
      </div>
    </header>

    <!-- Divider -->
    <div class="divider mt-0 mb-1"></div>

    <!-- Project Content -->
    <div class="prose-content max-w-none">
      <slot />
    </div>

    </article>
  </section>
</Layout>

<style is:global>
  .prose-content {
    color: inherit;
    line-height: 1.75;
  }

  .prose-content > :first-child {
    margin-top: 0;
  }

  .prose-content > :last-child {
    margin-bottom: 0;
  }

  .prose-content h1,
  .prose-content h2,
  .prose-content h3,
  .prose-content h4,
  .prose-content h5,
  .prose-content h6 {
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose-content h1 {
    font-size: 2.25rem;
  }

  .prose-content h2 {
    font-size: 1.875rem;
  }

  .prose-content h3 {
    font-size: 1.5rem;
  }

  .prose-content p {
    margin-bottom: 1rem;
  }

  .prose-content a {
    text-decoration: underline;
  }

  .prose-content ul,
  .prose-content ol {
    margin-bottom: 1rem;
    margin-left: 1.5rem;
    list-style-position: outside;
  }

  .prose-content ul {
    list-style-type: disc;
  }

  .prose-content ol {
    list-style-type: decimal;
  }

  .prose-content li {
    margin-bottom: 0.5rem;
  }

  .prose-content code {
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: ui-monospace, monospace;
  }

  .prose-content pre {
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .prose-content pre code {
    background: transparent;
    padding: 0;
  }

  .prose-content blockquote {
    border-left-width: 4px;
    padding-left: 1rem;
    font-style: italic;
    margin: 1rem 0;
  }

  .prose-content img {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  /* For MDX figures that manage their own spacing/alignment. */
  .prose-content img[data-figure-img] {
    margin: 0;
  }

  .prose-content strong {
    font-weight: 600;
  }
</style>
