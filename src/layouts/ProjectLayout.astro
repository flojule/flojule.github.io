---
import Layout from "./Layout.astro";
import "katex/dist/katex.min.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SkillBadge from "../components/SkillBadge.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import { ExternalLink } from "@lucide/astro";
import { siteConfig } from "../config";
import { getVideoMimeType, getVideoSources } from "../lib/video";
import { formatPeriod } from "../lib/date";

interface Props {
  title: string;
  description: string;
  startDate: Date;
  endDate?: Date;
  image: ImageMetadata;
  video?: string;
  skills: string[];
  demoLink?: string;
  demoLabel?: string;
  sourceLink?: string;
}

const {
  title,
  description,
  startDate,
  endDate,
  image,
  video,
  skills,
  demoLink,
  demoLabel = "Live Demo",
  sourceLink,
} = Astro.props;

const hasSkills = skills && skills.length > 0;
---

<Layout title={`${siteConfig.name} - ${title}`} description={description} image={image?.src}>
  <section class="bg-base-200">
    <article class="max-w-4xl mx-auto px-4 pt-3 pb-16">
    <!-- Featured Media -->
    {
      video ? (
        <figure class="mb-6 rounded-2xl overflow-hidden">
          <video
            data-autoplay
            muted
            loop
            playsinline
            preload="none"
            poster={image?.src}
            class="w-full aspect-video object-cover"
          >
            {getVideoSources(video).map((source) => (
              <source src={source} type={getVideoMimeType(source)} />
            ))}
            Your browser does not support this video format.
          </video>
        </figure>
      ) : image && (
        <figure class="mb-6 rounded-2xl overflow-hidden">
          <Image
            src={image}
            alt={title}
            class="w-full aspect-video object-cover"
            width={1200}
            height={630}
            sizes="(min-width: 1024px) 56rem, 100vw"
          />
        </figure>
      )
    }

    <!-- Project Header -->
    <header class="mb-2">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-3">{title}</h1>
      <p class="text-base sm:text-lg text-base-content/70 mb-3">{description}</p>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-base-content/60 mb-2">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="font-semibold">{formatPeriod(startDate, endDate)}</span>
          {
            !endDate && (
              <>
                <span class="text-base-content/30">|</span>
                <span class="badge badge-success badge-sm">Ongoing</span>
              </>
            )
          }
          {
            sourceLink && (
              <>
                <span class="text-base-content/30">|</span>
                <a
                  href={sourceLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 font-medium text-base-content/70 hover:text-primary transition-colors"
                >
                  <GithubIcon class="size-[18px]" />
                  View Source
                </a>
              </>
            )
          }

          {
            demoLink && (
              <>
                <span class="text-base-content/30">|</span>
                <a
                  href={demoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 font-medium text-base-content/70 hover:text-primary transition-colors"
                >
                  <ExternalLink class="size-4" />
                  {demoLabel}
                </a>
              </>
            )
          }
        </div>

        {
          hasSkills && (
            <>
              <span class="text-base-content/30">|</span>
              {skills.map((skill) => (
                <SkillBadge skill={skill} />
              ))}
            </>
          )
        }
      </div>
    </header>

    <!-- Divider -->
    <div class="divider mt-0 mb-1"></div>

    <!-- Project Content -->
    <div class="prose-content max-w-none">
      <slot />
    </div>

    </article>
  </section>
</Layout>

<style is:global>
  @reference "../styles/global.css";

  .prose-content {
    color: inherit;
    line-height: 1.75;
  }

  .prose-content > :first-child {
    margin-top: 0;
  }

  .prose-content > :last-child {
    margin-bottom: 0;
  }

  .prose-content h1,
  .prose-content h2,
  .prose-content h3,
  .prose-content h4,
  .prose-content h5,
  .prose-content h6 {
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose-content h1 {
    font-size: 2.25rem;
  }

  .prose-content h2 {
    font-size: 1.875rem;
  }

  .prose-content h3 {
    font-size: 1.5rem;
  }

  .prose-content p {
    margin-bottom: 1rem;
  }

  .prose-content a {
    text-decoration: underline;
  }

  .prose-content ul,
  .prose-content ol {
    margin-bottom: 1rem;
    margin-left: 1.5rem;
    list-style-position: outside;
  }

  .prose-content ul {
    list-style-type: disc;
  }

  .prose-content ol {
    list-style-type: decimal;
  }

  .prose-content li {
    margin-bottom: 0.5rem;
  }

  .prose-content code {
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: ui-monospace, monospace;
  }

  .prose-content pre {
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .prose-content pre code {
    background: transparent;
    padding: 0;
  }

  .prose-content blockquote {
    border-left-width: 4px;
    padding-left: 1rem;
    font-style: italic;
    margin: 1rem 0;
  }

  .prose-content img {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  /* Shared figure media (img + video) across project pages; intrinsic
     width/height on the element reserves the aspect ratio. Each element keeps
     only its width utility (w-full or max-w-full). */
  .prose-content :is(img, video)[data-figure-img] {
    display: block;
    height: auto;
    border-radius: 0.5rem;
    margin: 0;
  }

  .prose-content video[data-figure-img] {
    width: 100%;
  }

  /* Shared figure captions. */
  .prose-content figcaption {
    @apply mt-1 text-center text-xs font-semibold tracking-wide text-base-content/60 sm:text-sm;
  }

  .prose-content strong {
    font-weight: 600;
  }
</style>
