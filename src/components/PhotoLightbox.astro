---
// Full-screen photo viewer, rendered once per page by Layout.astro.
//
// Openers, anywhere in the document:
//   <a href="<src>" data-photo-lightbox="<group>">  — one entry per anchor;
//       anchors sharing a group name are browsed together with prev/next.
//   <button data-photo-gallery-open>                — the whole /gallery
//       folder (see gallery.json.ts), reshuffled on every open.

// Display is left to each button: the side arrows are desktop-only, so a
// `display` utility baked in here would fight their `hidden sm:flex`.
const navButtonClass =
  "shrink-0 items-center justify-center rounded-full bg-white/6 p-0 text-base-100 ring-1 ring-inset ring-white/25 transition-colors hover:bg-white/10";
---

<div
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 p-4"
  data-photo-lightbox-overlay
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
>
  <div
    class="relative z-10 flex h-full w-full max-w-6xl flex-col items-center justify-center gap-3 sm:flex-row"
  >
    <button
      type="button"
      class:list={[navButtonClass, "absolute right-0 top-0 z-10 inline-flex size-9 sm:size-8"]}
      aria-label="Close photo viewer"
      data-photo-lightbox-close
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5 sm:size-4.5"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
    <button
      type="button"
      class:list={[navButtonClass, "absolute left-0 top-1/2 hidden size-10 -translate-y-1/2 sm:flex"]}
      aria-label="Previous photo"
      data-photo-lightbox-prev
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <div class="flex w-full min-w-0 flex-1 items-center justify-center">
      <img
        alt=""
        class="surface-radius max-h-[72vh] w-auto max-w-full object-contain shadow-2xl sm:max-h-[85vh]"
        data-photo-lightbox-image
      />
    </div>
    <button
      type="button"
      class:list={[navButtonClass, "absolute right-0 top-1/2 hidden size-10 -translate-y-1/2 sm:flex"]}
      aria-label="Next photo"
      data-photo-lightbox-next
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
    <div class="flex items-center justify-center gap-10 sm:hidden">
      <button
        type="button"
        class:list={[navButtonClass, "inline-flex size-11"]}
        aria-label="Previous photo"
        data-photo-lightbox-prev
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-6"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        class:list={[navButtonClass, "inline-flex size-11"]}
        aria-label="Next photo"
        data-photo-lightbox-next
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-6"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  import { closeOverlay, isOverlayOpen, openOverlay } from "../lib/overlay";

  type Photo = { src: string; alt: string };

  // Every handler below is bound once at module scope and queries the DOM
  // lazily: view transitions swap the body, so any element captured at bind
  // time would be detached after the first navigation.
  let playlist: Photo[] = [];
  let index = 0;
  let lastTrigger: HTMLElement | null = null;

  const overlay = () => document.querySelector("[data-photo-lightbox-overlay]");

  // Fetched once per session; the module scope survives view transitions.
  let galleryCache: Photo[] | null = null;
  const galleryPhotos = async (): Promise<Photo[]> => {
    if (!galleryCache) {
      const base = import.meta.env.BASE_URL.endsWith("/")
        ? import.meta.env.BASE_URL
        : `${import.meta.env.BASE_URL}/`;
      const sources: string[] = await fetch(`${base}gallery.json`).then((r) => r.json());
      galleryCache = sources.map((src, i) => ({ src, alt: `Gallery photo ${i + 1}` }));
    }
    return galleryCache;
  };

  // Fisher-Yates on a copy: a fresh order every time the gallery is opened.
  const shuffle = <T,>(items: T[]) => {
    const out = [...items];
    for (let i = out.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [out[i], out[j]] = [out[j], out[i]];
    }
    return out;
  };

  const render = () => {
    const root = overlay();
    const image = root?.querySelector("[data-photo-lightbox-image]");
    const photo = playlist[index];
    if (!(image instanceof HTMLImageElement) || !photo) return;

    image.src = photo.src;
    image.alt = photo.alt;

    // Warm the neighbours so prev/next paint immediately.
    for (const step of [1, -1]) {
      const neighbour = playlist[(index + step + playlist.length) % playlist.length];
      if (neighbour && neighbour !== photo) new Image().src = neighbour.src;
    }
  };

  const move = (direction: number) => {
    if (playlist.length < 2) return;
    index = (index + direction + playlist.length) % playlist.length;
    render();
  };

  const close = () => {
    const root = overlay();
    if (!isOverlayOpen(root)) return;

    closeOverlay(root);

    const image = root.querySelector("[data-photo-lightbox-image]");
    if (image instanceof HTMLImageElement) image.removeAttribute("src");

    playlist = [];
    if (lastTrigger?.isConnected) lastTrigger.focus();
    lastTrigger = null;
  };

  const open = (photos: Photo[], startIndex: number, trigger: HTMLElement) => {
    const root = overlay();
    if (!(root instanceof HTMLElement) || photos.length === 0) return;

    playlist = photos;
    index = startIndex;
    lastTrigger = trigger;
    render();

    // A single photo has nowhere to go; hide the arrows rather than looping.
    const single = photos.length < 2;
    root.querySelectorAll("[data-photo-lightbox-prev], [data-photo-lightbox-next]").forEach(
      (button) => button.classList.toggle("invisible", single),
    );

    openOverlay(root);
    root.querySelector<HTMLElement>("[data-photo-lightbox-close]")?.focus();
  };

  // Capture phase: the view-transition router also listens for link clicks on
  // the document, and would navigate to the photo URL before a bubble-phase
  // handler here got the chance to call preventDefault().
  document.addEventListener(
    "click",
    (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest<HTMLAnchorElement>("a[data-photo-lightbox]");
      if (link) {
        // Modifier-clicks keep the browser's open-in-new-tab behaviour.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const group = Array.from(
          document.querySelectorAll<HTMLAnchorElement>("a[data-photo-lightbox]"),
        ).filter((a) => a.dataset.photoLightbox === link.dataset.photoLightbox);
        open(
          group.map((a) => ({
            src: a.getAttribute("href") || "",
            alt: a.textContent?.trim() || a.getAttribute("aria-label") || "Photo",
          })),
          Math.max(group.indexOf(link), 0),
          link,
        );
        return;
      }

      const galleryButton = target.closest<HTMLElement>("[data-photo-gallery-open]");
      if (galleryButton) {
        galleryPhotos().then((photos) => open(shuffle(photos), 0, galleryButton));
        return;
      }

      const root = overlay();
      if (!isOverlayOpen(root) || !root.contains(target)) return;
      if (target.closest("[data-photo-lightbox-prev]")) move(-1);
      else if (target.closest("[data-photo-lightbox-next]")) move(1);
      // Anything that is not the photo itself or a control is backdrop: the gaps
      // beside a portrait photo, below a landscape one, and the padding around
      // the arrows all dismiss the viewer.
      else if (!target.closest("[data-photo-lightbox-image]")) close();
    },
    true,
  );

  document.addEventListener("keydown", (event) => {
    if (!isOverlayOpen(overlay())) return;
    if (event.key === "Escape") {
      close();
    } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
      event.preventDefault();
      move(-1);
    } else if (event.key === "ArrowRight" || event.key === "ArrowDown") {
      event.preventDefault();
      move(1);
    }
  });
</script>
