---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const projectEntries = await getCollection("projects", ({ data }) => !data.draft);

// Sort by start date, most recent first. Copy first: getCollection hands back a
// cached array, and sorting in place mutates it for every other caller.
// Title breaks ties so projects sharing a start date keep a fixed order.
const sortedProjects = [...projectEntries].sort(
  (a, b) =>
    b.data.startDate.getTime() - a.data.startDate.getTime() ||
    a.data.title.localeCompare(b.data.title)
);

// Widest grid is 2 columns, so the first row is the only above-the-fold media.
const EAGER_COUNT = 2;
---

<section id="projects" class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
  {sortedProjects.map((project, index) => (
    <ProjectCard project={project} eager={index < EAGER_COUNT} />
  ))}
</section>
