---
import { Image } from "astro:assets";
import SkillBadge from "./SkillBadge.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import { ExternalLink } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { getVideoMimeType, getVideoSources } from "../lib/video";
import { formatPeriod } from "../lib/date";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const hasDemoLink = Boolean(project.data.demoLink);
const hasSourceLink = Boolean(project.data.sourceLink);
const actionCount = Number(hasDemoLink) + Number(hasSourceLink);
---

<article class="surface-card card overflow-hidden border border-base-300 shadow-lg transition-shadow hover:shadow-xl">
  <a href={`/projects/${project.id.split("/").pop()}`}>
    <figure class="aspect-video">
      {project.data.video ? (
        <video
          data-autoplay
          muted
          loop
          playsinline
          preload="none"
          poster={project.data.image.src}
          class="w-full h-full object-cover"
          style={project.data.imagePosition && `object-position: ${project.data.imagePosition}`}
          data-no-controls
        >
          {getVideoSources(project.data.video).map((source) => (
            <source src={source} type={getVideoMimeType(source)} />
          ))}
          Your browser does not support this video format.
        </video>
      ) : (
        <Image
          src={project.data.image}
          alt={project.data.title}
          class="w-full h-full object-cover"
          style={project.data.imagePosition && `object-position: ${project.data.imagePosition}`}
          width={600}
          height={400}
          sizes="(min-width: 1024px) 22rem, (min-width: 768px) calc(50vw - 2rem), 100vw"
        />
      )}
    </figure>
  </a>
  <div class="card-body gap-3 p-5 sm:p-6">
    <h3 class="card-title text-lg sm:text-xl hover:text-primary transition-colors">
      <a href={`/projects/${project.id.split("/").pop()}`}>{project.data.title}</a>
    </h3>
    <div class="flex items-center justify-between gap-3">
      <time class="text-sm text-base-content/60">
        {formatPeriod(project.data.startDate, project.data.endDate)}
      </time>
      {
        actionCount > 0 && (
          <div class="flex items-center gap-3 text-xs text-base-content/65">
            {
              project.data.demoLink && (
                <a
                  href={project.data.demoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open external link"
                  title="Open external link"
                  class="inline-flex items-center gap-1 rounded-md border border-base-content/10 bg-base-200/50 px-2 py-1 font-medium transition-colors hover:border-primary/20 hover:text-primary"
                >
                  <ExternalLink class="size-3.5" />
                  <span>Link</span>
                </a>
              )
            }
            {
              project.data.sourceLink && (
                <a
                  href={project.data.sourceLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open GitHub repository"
                  title="Open GitHub repository"
                  class="inline-flex items-center gap-1 rounded-md border border-base-content/10 bg-base-200/50 px-2 py-1 font-medium transition-colors hover:border-primary/20 hover:text-primary"
                >
                  <GithubIcon class="size-3.5" />
                  <span>GitHub</span>
                </a>
              )
            }
          </div>
        )
      }
    </div>
    <p class="text-sm sm:text-base text-base-content/80">{project.data.description}</p>
    <div class="flex flex-wrap gap-2 pt-1">
      {project.data.skills.map((skill) => <SkillBadge skill={skill} />)}
    </div>
  </div>
</article>
