---
import { Image, getImage } from "astro:assets";
import GithubIcon from "./icons/GithubIcon.astro";
import { ExternalLink } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { VIDEO_MIME_TYPE } from "../lib/video";
import { formatPeriod } from "../lib/date";

interface Props {
  project: CollectionEntry<"projects">;
  /** Cards above the fold skip lazy-loading so the LCP image is not deferred. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
// Prefer the card-sized encode; fall back to the full one when a project has none.
const cardVideo = project.data.cardVideo ?? project.data.video;
// Cards list the first few skills; the project page shows them all.
const MAX_CARD_SKILLS = 3;
const cardSkills = project.data.skills.slice(0, MAX_CARD_SKILLS);
const { team } = project.data;
const teamLabel = team && (team === 1 ? "Individual" : `Team of ${team}`);
const cardLink = "inline-flex items-center gap-1 text-base-content/70 transition-colors hover:text-primary";
const href = `/${project.id}`;
const cardImageSizes = "(min-width: 1024px) 22rem, (min-width: 768px) calc(50vw - 2rem), 100vw";
// The poster must not be the full-size original; render a card-sized derivative.
const poster = project.data.video
  ? (await getImage({ src: project.data.image, width: 640, format: "webp" })).src
  : undefined;
---

<article class="group surface-card flex flex-col border border-base-300 transition-colors hover:border-primary/40">
  {/* Same destination as the title link below, so it is hidden from the
       a11y tree instead of announced twice (and, for video cards, announced
       with no accessible name at all). */}
  <a href={href} tabindex="-1" aria-hidden="true">
    <figure class="aspect-video overflow-hidden bg-base-300">
      {project.data.video ? (
        <video
          data-autoplay
          data-no-prefetch
          muted
          loop
          playsinline
          preload="none"
          poster={poster}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none"
          style={project.data.imagePosition && `object-position: ${project.data.imagePosition}`}
          data-no-controls
        >
          <source src={cardVideo} type={VIDEO_MIME_TYPE} />
          Your browser does not support this video format.
        </video>
      ) : (
        <Image
          src={project.data.image}
          alt={project.data.title}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none"
          style={project.data.imagePosition && `object-position: ${project.data.imagePosition}`}
          width={640}
          widths={[320, 640, 960]}
          sizes={cardImageSizes}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
        />
      )}
    </figure>
  </a>
  <div class="flex flex-1 flex-col gap-1.5 p-4 sm:p-5">
    <h3 class="text-base font-semibold leading-snug sm:text-lg">
      <a href={href} class="transition-colors group-hover:text-primary">{project.data.title}</a>
    </h3>
    <p class="text-sm text-base-content/75">{project.data.description}</p>
    <div class="mt-auto flex items-center justify-between gap-3 pt-0.5 font-mono text-xs text-base-content/55">
      <span>
        <time>{formatPeriod(project.data.startDate, project.data.endDate)}</time>
        {teamLabel && <><span aria-hidden="true"> · </span><span>{teamLabel}</span></>}
      </span>
      <span class="flex items-center gap-3">
        {
          project.data.demoLink && (
            <a href={project.data.demoLink} target="_blank" rel="noopener noreferrer" aria-label={`Link: ${project.data.title}`} title="Link" class={cardLink}>
              <ExternalLink class="size-4" aria-hidden="true" />
            </a>
          )
        }
        {
          project.data.sourceLink && (
            <a href={project.data.sourceLink} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${project.data.title}`} title="GitHub" class={cardLink}>
              <GithubIcon class="size-4" />
            </a>
          )
        }
      </span>
    </div>
    {/* Wraps between skills, never inside one, so no skill is cut off. */}
    <p class="flex flex-wrap gap-x-1.5 text-xs text-base-content/55">
      {cardSkills.map((skill, i) => <span class="whitespace-nowrap">{i > 0 && <span aria-hidden="true">· </span>}{skill}</span>)}
    </p>
  </div>
</article>
