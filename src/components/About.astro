---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { EducationEntry } from "../config";

interface Props {
  name: string;
  headline: string;
  location?: string;
  description: string[];
  photo: ImageMetadata;
  education: EducationEntry[];
}

const { name, headline, location, description, photo, education } = Astro.props;

// The page shows a small thumbnail; the lightbox opens a larger derivative
// rather than the multi-hundred-KB original.
const photoSrc = (await getImage({ src: photo, width: 1200, format: "webp" })).src;
---

{/* Sticky only when the viewport is tall enough to show the whole column. */}
<section id="about" aria-labelledby="about-name" class="scroll-mt-20 space-y-5 lg:order-first lg:self-start lg:[@media(min-height:49rem)]:sticky lg:[@media(min-height:49rem)]:top-20">
  {/* The photo stretches to the height of the name block. */}
  <div class="flex gap-3">
    <a
      href={photoSrc}
      data-photo-lightbox="portrait"
      aria-label={`View photo of ${name}`}
      class="w-16 shrink-0 overflow-hidden rounded-md cursor-zoom-in"
    >
      <Image src={photo} alt={name} width={128} widths={[64, 128, 192]} sizes="64px" loading="eager" class="size-full object-cover" />
    </a>
    <div class="min-w-0">
      <h2 id="about-name" class="text-lg font-semibold leading-snug">{name}</h2>
      {/* One line per " | " segment. */}
      <p class="text-sm text-base-content/70">{headline.split(" | ").map((line) => <span class="block">{line}</span>)}</p>
      {location && <p class="text-sm text-base-content/55">{location}</p>}
    </div>
  </div>

  <div class="space-y-3 text-sm leading-relaxed text-base-content/80 [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors hover:[&_a]:text-primary/80">
    {description.map((line) => <p set:html={line} />)}
  </div>

  <div>
    <h3 class="mb-1 text-sm font-semibold">Education</h3>
    <ul>
      {education.map((entry) => (
        <li class="border-t border-base-300 py-2.5">
          <div class="flex items-baseline justify-between gap-3">
            {
              entry.link ? (
                <a href={entry.link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium transition-colors hover:text-primary">
                  {entry.school}
                </a>
              ) : (
                <p class="text-sm font-medium">{entry.school}</p>
              )
            }
            <p class="whitespace-nowrap font-mono text-xs text-base-content/55">{entry.year}</p>
          </div>
          <p class="text-xs text-base-content/60">{entry.degree}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
