---
import { Image } from "astro:assets";

interface EducationEntry {
  title: string;
  subtitle: string;
  startDate: Date;
  endDate?: Date;
  link?: string;
  graduationLabel?: string;
}

interface Props {
  name: string;
  headline: string;
  location?: string;
  description: string[];
  photo?: string | { src: string };
  education: EducationEntry[];
}

const {
  name,
  headline,
  location,
  description,
  photo,
  education,
} = Astro.props;

const photoSrc = typeof photo === "string" ? photo : photo?.src;

function formatGraduation(entry: EducationEntry) {
  if (entry.graduationLabel) {
    return entry.graduationLabel;
  }

  if (entry.endDate) {
    return `${entry.endDate.getFullYear()}`;
  }

  return `${entry.startDate.getFullYear()}`;
}
---

<section id="about" class="bg-base-200 px-4 pt-3 pb-16" data-about-lightbox-root>
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-5 md:gap-6 lg:grid-cols-[minmax(0,1.45fr)_minmax(18rem,1fr)]">
      <article class="surface-card order-2 lg:order-1 lg:row-span-2 card border border-base-300 shadow-lg">
        <div class="card-body">
          <div class="space-y-3">
            <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between md:gap-4">
              <h2 class="text-2xl sm:text-3xl font-bold">Hi, I'm {name}</h2>
              {location && (
                <p class="text-sm uppercase tracking-[0.15em] text-base-content/60 md:text-right">
                  {location}
                </p>
              )}
            </div>
            <p class="font-serif text-lg leading-snug text-base-content/85 sm:text-xl">
              {headline}
            </p>

            <div class="space-y-3 text-base leading-relaxed text-base-content/80 [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors hover:[&_a]:text-primary/80">
              {description.map((line) => (
                line.trim()
                  ? <p set:html={line} />
                  : <p>&nbsp;</p>
              ))}
            </div>
          </div>
        </div>
      </article>

      {
        photoSrc && (
          <div class="surface-card order-1 lg:order-2 lg:col-start-2 card border border-base-300 shadow-lg">
            <div class="card-body items-center">
              <a
                href={photoSrc}
                data-photo-lightbox-solo
                aria-label={`View photo of ${name}`}
                class="w-40 overflow-hidden surface-radius block cursor-zoom-in"
              >
                {
                  typeof photo === "string" ? (
                    <img
                      src={photoSrc}
                      alt={name}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <Image
                      src={photo}
                      alt={name}
                      width={320}
                      height={320}
                      sizes="(min-width: 1024px) 320px, 160px"
                      class="h-full w-full object-cover"
                    />
                  )
                }
              </a>
            </div>
          </div>
        )
      }

      <aside class="surface-card order-3 lg:order-3 lg:col-start-2 card border border-base-300 shadow-lg">
        <div class="card-body">
          <h3 class="card-title text-2xl">Education</h3>
          <ul class="space-y-4">
            {education.map((entry) => (
              <li class="border-b border-base-300 pb-4 last:border-b-0 last:pb-0">
                <div class="space-y-1">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                    {
                      entry.link ? (
                        <a
                          href={entry.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-semibold hover:text-primary transition-colors"
                        >
                          {entry.title}
                        </a>
                      ) : (
                        <p class="font-semibold">{entry.title}</p>
                      )
                    }
                    <p class="text-sm font-mono whitespace-nowrap text-base-content/60">
                      {formatGraduation(entry)}
                    </p>
                  </div>
                  <p class="text-sm text-secondary font-medium">
                    {entry.subtitle}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </aside>

    </div>
  </div>

  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 p-4"
    data-photo-lightbox-overlay
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
  >
    <button
      type="button"
      class="absolute inset-0 h-full w-full cursor-default"
      aria-label="Close photo viewer"
      data-photo-lightbox-close
    ></button>
    <div class="relative z-10 flex w-full max-w-6xl flex-col items-center justify-center gap-3 sm:flex-row">
      <button
        type="button"
        class="z-10 inline-flex size-9 shrink-0 items-center justify-center self-end rounded-full bg-white/6 text-base-100 ring-1 ring-inset ring-white/25 transition-colors hover:bg-white/10 sm:absolute sm:right-0 sm:top-0 sm:size-8 sm:self-auto"
        aria-label="Close photo viewer"
        data-photo-lightbox-close
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5 sm:size-4.5"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
      <button
        type="button"
        class="hidden size-10 shrink-0 items-center justify-center rounded-full bg-white/6 p-0 text-base-100 ring-1 ring-inset ring-white/25 transition-colors hover:bg-white/10 sm:inline-flex"
        aria-label="Previous photo"
        data-photo-lightbox-prev
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <div class="flex w-full min-w-0 flex-1 items-center justify-center">
        <img
          alt=""
          class="surface-radius max-h-[72vh] w-auto max-w-full object-contain shadow-2xl sm:max-h-[85vh]"
          data-photo-lightbox-image
        />
      </div>
      <button
        type="button"
        class="hidden size-10 shrink-0 items-center justify-center rounded-full bg-white/6 p-0 text-base-100 ring-1 ring-inset ring-white/25 transition-colors hover:bg-white/10 sm:inline-flex"
        aria-label="Next photo"
        data-photo-lightbox-next
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
      <div class="flex items-center justify-center gap-10 sm:hidden" data-photo-lightbox-mobile-nav>
        <button
          type="button"
          class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-white/6 p-0 text-base-100 ring-1 ring-inset ring-white/25 transition-colors hover:bg-white/10"
          aria-label="Previous photo"
          data-photo-lightbox-prev
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-6"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>
        <button
          type="button"
          class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-white/6 p-0 text-base-100 ring-1 ring-inset ring-white/25 transition-colors hover:bg-white/10"
          aria-label="Next photo"
          data-photo-lightbox-next
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-6"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const initPhotoLightbox = () => {
    const root = document.querySelector("[data-about-lightbox-root]");

    if (!(root instanceof HTMLElement) || root.dataset.photoLightboxReady === "true") {
      return;
    }

    root.dataset.photoLightboxReady = "true";

    const overlay = root.querySelector("[data-photo-lightbox-overlay]");
    const image = root.querySelector("[data-photo-lightbox-image]");
    const triggers = Array.from(root.querySelectorAll("a[data-photo-lightbox='true']"));
    const soloTrigger = root.querySelector("a[data-photo-lightbox-solo]");
    const closeButtons = root.querySelectorAll("[data-photo-lightbox-close]");
    const previousButtons = Array.from(root.querySelectorAll("[data-photo-lightbox-prev]"));
    const nextButtons = Array.from(root.querySelectorAll("[data-photo-lightbox-next]"));

    if (
      overlay instanceof HTMLElement &&
      image instanceof HTMLImageElement &&
      previousButtons.length > 0 &&
      nextButtons.length > 0
    ) {
      let lastActiveElement = null;
      let currentIndex = 0;
      let soloMode = false;

      const renderPhoto = (index) => {
        const trigger = triggers[index];

        if (!(trigger instanceof HTMLAnchorElement)) {
          return;
        }

        image.src = trigger.getAttribute("href") || "";
        image.alt = trigger.textContent?.trim() || "Photo";
        currentIndex = index;
      };

      const closeLightbox = () => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        image.removeAttribute("src");
        image.removeAttribute("alt");
        soloMode = false;
        previousButtons.forEach((button) => button.classList.remove("invisible"));
        nextButtons.forEach((button) => button.classList.remove("invisible"));
        document.body.classList.remove("overflow-hidden");

        if (lastActiveElement instanceof HTMLElement) {
          lastActiveElement.focus();
        }
      };

      const movePhoto = (direction) => {
        if (soloMode) return;
        const nextIndex = (currentIndex + direction + triggers.length) % triggers.length;
        renderPhoto(nextIndex);
      };

      const openLightbox = (index, trigger) => {
        lastActiveElement = trigger;
        renderPhoto(index);
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
        document.body.classList.add("overflow-hidden");
      };

      const openSoloLightbox = (src: string, alt: string, trigger: HTMLElement) => {
        lastActiveElement = trigger;
        soloMode = true;
        image.src = src;
        image.alt = alt;
        previousButtons.forEach((button) => button.classList.add("invisible"));
        nextButtons.forEach((button) => button.classList.add("invisible"));
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
        document.body.classList.add("overflow-hidden");
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          openLightbox(index, trigger);
        });
      });

      if (soloTrigger instanceof HTMLAnchorElement) {
        soloTrigger.addEventListener("click", (event) => {
          event.preventDefault();
          openSoloLightbox(
            soloTrigger.getAttribute("href") || "",
            soloTrigger.getAttribute("aria-label") || "Photo",
            soloTrigger,
          );
        });
      }

      closeButtons.forEach((button) => {
        button.addEventListener("click", closeLightbox);
      });

      previousButtons.forEach((button) => button.addEventListener("click", () => movePhoto(-1)));
      nextButtons.forEach((button) => button.addEventListener("click", () => movePhoto(1)));

      document.addEventListener("keydown", (event) => {
        if (!overlay.classList.contains("hidden")) {
          if (event.key === "Escape") {
            closeLightbox();
          } else if (!soloMode && (event.key === "ArrowLeft" || event.key === "ArrowUp")) {
            event.preventDefault();
            movePhoto(-1);
          } else if (!soloMode && (event.key === "ArrowRight" || event.key === "ArrowDown")) {
            event.preventDefault();
            movePhoto(1);
          }
        }
      });
    }
  };

  initPhotoLightbox();
  document.addEventListener("astro:page-load", initPhotoLightbox);
</script>
