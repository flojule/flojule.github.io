---
import Layout from "../layouts/Layout.astro";
import { House, ArrowLeft } from "@lucide/astro";
import { siteConfig } from "../config";
---

<Layout
  title={`${siteConfig.name} - 500`}
  description="An error occurred while processing your request."
>
  <div class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-2xl mx-auto">
      <!-- Large 500 Number -->
      <h1 class="text-9xl font-bold text-error mb-4 animate-pulse">500</h1>

      <!-- Error Title -->
      <h2 class="text-4xl font-bold mb-4">Server Error</h2>

      <!-- Error Description -->
      <p class="text-xl mb-8 text-base-content/70">
        An unexpected error occurred while processing your request.
        <br />
        Please try again later or contact support if the problem persists.
      </p>

      <!-- Divider -->
      <div class="divider"></div>

      <!-- Action Buttons -->
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href="/" class="btn btn-primary gap-2">
          <House class="size-5" />
          Go Home
        </a>
        <button type="button" data-go-back class="btn btn-outline gap-2">
          <ArrowLeft class="size-5" />
          Go Back
        </button>
      </div>

      <!-- Helpful Links -->
      <div class="mt-8">
        <p class="text-sm text-base-content/60 mb-4">Need help?</p>
        <div class="flex gap-3 justify-center flex-wrap text-sm">
          <a href="/about" class="link link-hover">About</a>
          <span class="text-base-content/30">•</span>
          <a href="/projects" class="link link-hover">Projects</a>
        </div>
      </div>
    </div>
  </div>

<script>
  const initGoBack = () => {
    const button = document.querySelector("[data-go-back]");
    if (!(button instanceof HTMLElement) || button.dataset.goBackReady === "true") return;
    button.dataset.goBackReady = "true";
    button.addEventListener("click", () => history.back());
  };

  initGoBack();
  document.addEventListener("astro:page-load", initGoBack);
</script>
</Layout>
