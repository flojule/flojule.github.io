---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config";
import portrait from "../assets/nyse.webp";

// Copy before sorting: getCollection returns a cached array that must not be
// reordered in place.
const educationEntries = [...(await getCollection("education"))]
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime())
  .map(({ data }) => data);
---

<Layout
  title={`${siteConfig.name} - About Me`}
  description={siteConfig.aboutDescription}
  contentClass="bg-base-200"
>
  <main class="bg-base-200">
    <About
      name={siteConfig.name}
      headline={siteConfig.title}
      location={siteConfig.location}
      description={siteConfig.description}
      photo={portrait}
      education={educationEntries}
    />
  </main>
</Layout>
