---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ChevronLeft } from "@lucide/astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { siteConfig } from "../../config";

const projects = await getCollection("projects", ({ data }) => !data.draft);

// Sort by start date, most recent first
const sortedProjects = projects.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);
---

<Layout
  title={`${siteConfig.name} - Projects`}
  description={siteConfig.projectsIndexDescription}
  contentClass="bg-base-200"
>
  <main class="bg-base-200 px-4 pt-3 pb-16">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-10">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold">Projects</h1>
      </div>

      <!-- Back to Home -->
      <div class="mb-6">
        <a href="/" class="btn btn-ghost btn-sm">
          <ChevronLeft class="size-5" />
          Back to Home
        </a>
      </div>

      <!-- Projects Grid -->
      {
        sortedProjects.length === 0 ? (
          <div class="text-center py-20">
            <p class="text-2xl text-base-content/60">
              No projects yet. Check back soon!
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
            {sortedProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        )
      }
    </div>
  </main>
</Layout>
